  "configuration": {
    "query": {
      "query": "WITH original AS (\n SELECT processed_input,weight FROM ML.WEIGHTS(MODEL `citric-glow-485600-f4.icu_ml.bqml_lr_v3`)\n), control AS (\n SELECT processed_input,weight FROM ML.WEIGHTS(MODEL `citric-glow-485600-f4.icu_ml.bqml_lr_v4_pit_autosplit_control`)\n), final AS (\n SELECT processed_input,weight FROM ML.WEIGHTS(MODEL `citric-glow-485600-f4.icu_ml.bqml_lr_v4_pit`)\n)\nSELECT COALESCE(o.processed_input,c.processed_input,f.processed_input) AS feature,\n o.weight AS old_weight,c.weight AS pit_auto_weight,f.weight AS pit_custom_weight,\n f.weight-c.weight AS custom_minus_auto_weight\nFROM original o FULL OUTER JOIN control c USING(processed_input)\nFULL OUTER JOIN final f USING(processed_input)\nORDER BY feature;\n",
